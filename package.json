{
  "name": "tenno-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A free, open-source Warframe mastery tracker. Unofficial fan project.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync:items": "node scripts/sync-items.mjs",
    "sync:mission-data": "node scripts/sync-mission-data.mjs",
    "sync:game-data": "node scripts/sync-game-data.mjs",
    "sync:all": "npm run sync:items && npm run sync:game-data"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@fontsource/rajdhani": "^5.2.6",
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "idb": "^8.0.3",
    "lz-string": "^1.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}

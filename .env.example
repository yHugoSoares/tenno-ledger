# Copy this file to .env on the VPS and fill in your domain.
# Caddy reads DOMAIN from the environment.

# Apex domain served by Caddy. www.<DOMAIN> redirects here.
DOMAIN=example.com

# Optional: email address for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# Optional: override the GitHub URL shown in the header and footer.
VITE_GITHUB_URL=https://github.com/yHugoSoares/tenno-ledger

# Optional: change how often the item mirror refreshes (seconds, default 24h).
SYNC_INTERVAL_SECONDS=86400
